{
  "Comment": "Investigates one inquiry. Started by an EventBridge Pipe from the job queue (batch size 1). The inquiry agent on AgentCore Runtime reports back with the task token.",
  "QueryLanguage": "JSONata",
  "StartAt": "ReadJob",
  "States": {
    "ReadJob": {
      "Type": "Pass",
      "Assign": {
        "job": "{% $parse($states.input[0].body) %}"
      },
      "Next": "MarkInvestigating"
    },
    "MarkInvestigating": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${CaseTableName}",
        "Key": {"caseId": {"S": "{% $job.caseId %}"}},
        "UpdateExpression": "SET #status = :investigating, updatedAt = :now",
        "ConditionExpression": "#status = :received",
        "ExpressionAttributeNames": {"#status": "status"},
        "ExpressionAttributeValues": {
          ":investigating": {"S": "INVESTIGATING"},
          ":received": {"S": "RECEIVED"},
          ":now": {"S": "{% $now() %}"}
        }
      },
      "Catch": [
        {
          "Comment": "The case is missing or was already picked up: a duplicate delivery.",
          "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"],
          "Next": "DuplicateJob"
        }
      ],
      "Next": "Investigate"
    },
    "DuplicateJob": {
      "Type": "Succeed",
      "Comment": "Nothing to do. The first delivery owns the case."
    },
    "Investigate": {
      "Type": "Task",
      "Comment": "The dispatcher starts the agent and returns at once. The task waits for SendTaskSuccess or SendTaskFailure from the agent.",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Arguments": {
        "FunctionName": "${DispatcherFunctionArn}",
        "Payload": {
          "payload": {
            "action": "investigate",
            "taskToken": "{% $states.context.Task.Token %}",
            "caseId": "{% $job.caseId %}",
            "job": "{% $job %}"
          }
        }
      },
      "TimeoutSeconds": 900,
      "Retry": [
        {
          "ErrorEquals": [
            "DispatchFailed",
            "InvestigationFailed",
            "States.Timeout",
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 20,
          "MaxAttempts": 2,
          "BackoffRate": 3,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Assign": {"failure": "{% $states.errorOutput %}"},
          "Next": "MarkFailed"
        }
      ],
      "Output": "{% $states.result %}",
      "Next": "StoreFindings"
    },
    "StoreFindings": {
      "Type": "Task",
      "Comment": "Stores the findings on the case and opens a new proposal version for approval.",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${CaseTableName}",
        "Key": {"caseId": {"S": "{% $job.caseId %}"}},
        "UpdateExpression": "SET #status = :next, findings = :findings, proposedAction = :action, draftReply = :reply, updatedAt = :now ADD proposalVersion :one",
        "ConditionExpression": "#status = :investigating",
        "ExpressionAttributeNames": {"#status": "status"},
        "ExpressionAttributeValues": {
          ":next": {"S": "{% $exists($states.input.findings.proposedAction) ? 'PENDING_APPROVAL' : 'NO_ACTION_PROPOSED' %}"},
          ":findings": {"S": "{% $string($states.input.findings) %}"},
          ":action": {"S": "{% $exists($states.input.findings.proposedAction) ? $string($states.input.findings.proposedAction) : 'null' %}"},
          ":reply": {"S": "{% $states.input.findings.draftReply %}"},
          ":investigating": {"S": "INVESTIGATING"},
          ":one": {"N": "1"},
          ":now": {"S": "{% $now() %}"}
        }
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Assign": {"failure": "{% $states.errorOutput %}"},
          "Next": "MarkFailed"
        }
      ],
      "End": true
    },
    "MarkFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${CaseTableName}",
        "Key": {"caseId": {"S": "{% $job.caseId %}"}},
        "UpdateExpression": "SET #status = :failed, failureReason = :reason, updatedAt = :now",
        "ConditionExpression": "#status IN (:received, :investigating)",
        "ExpressionAttributeNames": {"#status": "status"},
        "ExpressionAttributeValues": {
          ":failed": {"S": "FAILED"},
          ":reason": {"S": "{% $substring($failure.Error & ': ' & $failure.Cause, 0, 1000) %}"},
          ":received": {"S": "RECEIVED"},
          ":investigating": {"S": "INVESTIGATING"},
          ":now": {"S": "{% $now() %}"}
        }
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "SendToFailureQueue"
        }
      ],
      "Next": "SendToFailureQueue"
    },
    "SendToFailureQueue": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage",
      "Arguments": {
        "QueueUrl": "${FailureQueueUrl}",
        "MessageBody": "{% $string({'stage': 'investigate', 'caseId': $job.caseId, 'error': $failure.Error, 'cause': $failure.Cause, 'job': $job, 'executionId': $states.context.Execution.Id}) %}"
      },
      "Next": "InvestigationFailed"
    },
    "InvestigationFailed": {
      "Type": "Fail",
      "Error": "{% $failure.Error %}",
      "Cause": "{% $substring($exists($failure.Cause) ? $failure.Cause : '', 0, 1000) %}"
    }
  }
}
