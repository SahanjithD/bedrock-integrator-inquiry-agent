# Copy to Config.toml for a local run. On AgentCore Runtime, scripts/04-agent.sh passes each value
# below as its own BAL_CONFIG_VAR_<NAME> environment variable, for example BAL_CONFIG_VAR_GATEWAYURL.
# No secrets here: gateway tokens come from AgentCore Identity credential providers.

awsRegion = "us-east-1"

# Claude Sonnet 5.5 through the US cross-Region inference profile.
modelId = "us.anthropic.claude-sonnet-5-5"
maxTokens = 16000
maxIterations = 12
# Well under the 15-minute limit of a synchronous InvokeAgentRuntime request.
investigationTimeoutSeconds = 600

guardrailId = "<GUARDRAIL_ID>"
guardrailVersion = "1"

knowledgeBaseId = "<KNOWLEDGE_BASE_ID>"
customDataSourceId = "<CUSTOM_DATA_SOURCE_ID>"
knowledgeResults = 5

gatewayUrl = "https://<GATEWAY_ID>.gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp"
investigatorCredentialProvider = "inquiry-agent-investigator"
applierCredentialProvider = "inquiry-agent-applier"
readScopes = ["inquiry-gateway/read"]
writeScopes = ["inquiry-gateway/write"]

# Local runs only: AgentCore Runtime passes a workload access token with each request, a local
# run does not. Name a workload identity (for example one created with
# `aws bedrock-agentcore-control create-workload-identity --name inquiry-agent-local`) and the
# agent fetches a token for it and localUserId. Leave localWorkloadName out on AgentCore Runtime.
localWorkloadName = "inquiry-agent-local"
localUserId = "local-developer"
