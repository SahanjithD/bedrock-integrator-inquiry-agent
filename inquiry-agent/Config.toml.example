# Copy to Config.toml for a local run. On Amazon ECS, infra/cloudformation/agent-ecs.yaml passes
# the same settings in the BAL_CONFIG_DATA environment variable.
#
# The Cognito client secrets are not settings. ECS injects them from AWS Secrets Manager as the
# INVESTIGATOR_CLIENT_SECRET and APPLIER_CLIENT_SECRET environment variables. Set those two
# variables yourself for a local run.

awsRegion = "us-east-1"

jobQueueUrl = "https://sqs.us-east-1.amazonaws.com/<ACCOUNT_ID>/inquiry-agent-jobs"
decisionQueueUrl = "https://sqs.us-east-1.amazonaws.com/<ACCOUNT_ID>/inquiry-agent-decisions"
jobVisibilitySeconds = 900
decisionVisibilitySeconds = 300
retryDelaySeconds = 60
maxAttempts = 3

# Claude Sonnet 5.5 through the US cross-Region inference profile.
modelId = "us.anthropic.claude-sonnet-5-5"
maxTokens = 4096
maxIterations = 12

guardrailId = "<GUARDRAIL_ID>"
guardrailVersion = "1"

knowledgeBaseId = "<KNOWLEDGE_BASE_ID>"
customDataSourceId = "<CUSTOM_DATA_SOURCE_ID>"
knowledgeResults = 5

caseTable = "inquiry-agent-cases"

gatewayUrl = "https://<GATEWAY_ID>.gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp"
tokenUrl = "https://<COGNITO_DOMAIN>.auth.us-east-1.amazoncognito.com/oauth2/token"
investigatorClientId = "<INVESTIGATOR_CLIENT_ID>"
applierClientId = "<APPLIER_CLIENT_ID>"
readScopes = ["inquiry-gateway/read"]
writeScopes = ["inquiry-gateway/write"]
